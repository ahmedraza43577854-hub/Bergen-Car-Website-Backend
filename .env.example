PORT=4001

# AutoSalesReviews inventory API (Dealer Review and Inventory Platform)
AUTOSALESREVIEWS_API_URL=https://dealer-review-and-inventory-platfor-gamma.vercel.app
INTERNAL_API_KEY=
AUTOSALESREVIEWS_DEALER_SLUG=bergen-car

# Postgres (Neon pooled URL). Keep pgbouncer=true when talking through a pooler.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&pgbouncer=true"

# SMTP — used for lead notifications and newsletter confirmations
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Bergen Motors <hello@example.com>"
ADMIN_EMAIL=admin@example.com,second@example.com

# Dashboard login — comma-separated emails that may sign in at /dashboard
DASHBOARD_EMAIL=admin@bergenmotors.com
DASHBOARD_PASSWORD=Bergen123
DASHBOARD_SECRET=

# Comma-separated browser origins allowed to call this API
# Include every browser origin that calls this API (frontend hosts, not the API host).
# Live API hostname: https://bergen.backend-apis-dev.cloud
CORS_ORIGIN="https://bergenmotors.com,https://www.bergenmotors.com,https://bergencarcompany.com,https://www.bergencarcompany.com,https://bergen.187.77.19.146.sslip.io,http://localhost:3000"
